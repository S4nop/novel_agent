# ── LLM provider ──────────────────────────────────────────────────────────────
# provider=gemini  → native google-genai SDK (recommended: keeps safety-setting
#                    control, which this project needs for dark genre fiction)
# provider=openai  → any OpenAI-Chat-compatible endpoint (OpenAI, Moonshot/Kimi,
#                    DeepSeek, Upstage Solar, OpenRouter, local vLLM/Ollama …)
NOVEL_LLM_PROVIDER=gemini
NOVEL_LLM_MODEL=gemini-3.6-flash
NOVEL_LLM_API_KEY=

# Only for provider=openai. Either set a preset or an explicit base URL.
#   presets: openai | moonshot | deepseek | upstage | openrouter | gemini-compat
# NOVEL_LLM_PRESET=moonshot
# NOVEL_LLM_BASE_URL=http://localhost:11434/v1

# ── cost meter (USD per 1M tokens — match your chosen model) ──────────────────
NOVEL_PRICE_IN_PER_1M=1.50
NOVEL_PRICE_OUT_PER_1M=7.50
NOVEL_USD_KRW=1400

# ── misc ─────────────────────────────────────────────────────────────────────
NOVEL_UI_LANGUAGE=ko
NOVEL_PROJECTS_ROOT=./data/projects

# ── examples for other providers ─────────────────────────────────────────────
# Kimi K3
#   NOVEL_LLM_PROVIDER=openai
#   NOVEL_LLM_MODEL=kimi-k3
#   NOVEL_LLM_PRESET=moonshot
#   NOVEL_PRICE_IN_PER_1M=3.00
#   NOVEL_PRICE_OUT_PER_1M=15.00
#
# Local model via Ollama
#   NOVEL_LLM_PROVIDER=openai
#   NOVEL_LLM_MODEL=qwen3
#   NOVEL_LLM_BASE_URL=http://localhost:11434/v1
#   NOVEL_LLM_API_KEY=ollama
#   NOVEL_PRICE_IN_PER_1M=0
#   NOVEL_PRICE_OUT_PER_1M=0
